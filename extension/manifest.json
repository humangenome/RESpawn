{
  "manifest_version": 3,
  "name": "RESpawn: RES features for New Reddit",
  "short_name": "RESpawn",
  "version": "0.1.0",
  "description": "Keeps the new Reddit look and brings back old Reddit and RES features. Not affiliated with the RES team or Reddit.",
  "permissions": [
    "storage"
  ],
  "host_permissions": [
    "https://old.reddit.com/*"
  ],
  "content_scripts": [
    {
      "matches": [
        "https://www.reddit.com/*"
      ],
      "js": [
        "respawn.js"
      ],
      "css": [
        "respawn.css"
      ],
      "run_at": "document_start"
    }
  ],
  "background": {
    "service_worker": "background.js"
  },
  "homepage_url": "https://github.com/humangenome/RESpawn",
  "icons": {
    "16": "icons/icon-16.png",
    "32": "icons/icon-32.png",
    "48": "icons/icon-48.png",
    "128": "icons/icon-128.png"
  }
}
